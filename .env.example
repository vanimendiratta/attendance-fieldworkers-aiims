# =============================================================================
# Attendance Fieldworkers — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file or production secrets to source control.
# =============================================================================

# ---- PostgreSQL Database ---------------------------------------------------
# Supabase connection string. For Vercel serverless, use the Supabase Transaction
# Pooler URI (port 6543) rather than the direct session connection (port 5432).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres

# Dedicated test database URL. NEVER point this at production!
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_test

# Connection pool limit. Keep low (1-2) for serverless environments (Vercel).
DB_POOL_MAX=2

# ---- Supabase API & Storage --------------------------------------------------
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Public anon key (used by frontend / automated REST keep-alive queries)
SUPABASE_ANON_KEY=
# Server-side ONLY. NEVER expose this key to browser or frontend clients.
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated private storage bucket for check-in / check-out photos
SUPABASE_STORAGE_BUCKET=attendance-photos

# ---- Supabase Keep-Alive Health-Check (Optional Overrides) --------------------
# Request timeout in milliseconds (default: 10000)
KEEPALIVE_TIMEOUT_MS=10000
# Retries on transient network errors (default: 1)
KEEPALIVE_RETRIES=1

# ---- Application & Initial Admin Setup --------------------------------------
# Required during first-time database seed (npm run seed). Must be strong.
ADMIN_PASSWORD=
ADMIN_USERNAME=aiims_admin
ORG_NAME=AIIMS
OFFICE_NAME=AIIMS, New Delhi
OFFICE_LAT=28.5672
OFFICE_LNG=77.2100

# ---- CORS / Deployment ------------------------------------------------------
# Comma-separated list of allowed web origins (Netlify frontend, localhost)
ALLOWED_ORIGINS=https://checkin-checkout-aiims.netlify.app,http://localhost:3000

# ---- Daily Attendance Backup & SMTP Settings --------------------------------
# Standard SMTP configuration (works with Gmail, Outlook, Amazon SES, SendGrid)
# For Gmail, use an App Password (16 characters) generated at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="AIIMS Attendance" <your-email@gmail.com>

# Target email address to receive daily attendance backup CSV file
BACKUP_EMAIL_RECIPIENT=vanicder01@gmail.com

# Optional secret for securing automated Vercel cron endpoints
CRON_SECRET=

# ---- Server Runtime ---------------------------------------------------------
PORT=3000
NODE_ENV=development

